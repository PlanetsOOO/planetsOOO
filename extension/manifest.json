{
  "manifest_version": 3,
  "name": "Orbit Screensaver",
  "version": "2.6.2",
  "description": "Fullscreen idle screensaver for the Orbit solar system tour on planets.ooo.",
  "permissions": [
    "idle",
    "storage",
    "tabs",
    "system.display",
    "identity",
    "identity.email"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "https://www.planets.ooo/*",
    "https://planets.ooo/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.planets.ooo/*",
        "https://planets.ooo/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "planetsContent.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://www.planets.ooo/*",
      "https://planets.ooo/*"
    ]
  },
  "action": {
    "default_title": "Orbit Screensaver",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://www.planets.ooo https://planets.ooo http://localhost http://127.0.0.1; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  }
}
