# xAI Grok — AI flight assistant (/api/ai/guide)
# Get a key: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-20-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# Stripe Premium checkout — server-only, configure in Vercel too.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MULTIPLAYER_PRICE_ID=
PREMIUM_ENTITLEMENT_SECRET=
# Chrome extension OAuth client (type: Chrome extension; ID = published extension id)
CHROME_EXTENSION_OAUTH_CLIENT_ID=
# Writable path for entitlements.json on production (Vercel needs persistent storage)
ENTITLEMENT_DATA_PATH=
AUTH_SECRET=
# Comma-separated emails that get complimentary subscribed access after verify.
# Defaults to contact@planets.ooo when unset.
ADMIN_SUBSCRIPTION_EMAILS=contact@planets.ooo
# Optional Resend key for verification emails. Without it, signup/login returns a one-time verifyUrl.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Orbit <noreply@planets.ooo>

# Public site URL for Stripe return links
NEXT_PUBLIC_SITE_URL=https://www.planets.ooo
# Chrome Web Store listing URL (optional; defaults to Orbit Screensaver listing)
NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/orbit-screensaver/offmjpepigbhckfpagcghbjlonjljlnp
