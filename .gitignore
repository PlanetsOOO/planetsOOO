# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# packaged extension zips
/dist

# misc
.DS_Store
*.pem
.data/
data/entitlements.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Python deps for texture scripts
scripts/.pydeps/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated landing videos (manifest.json is tracked)
/public/data/landings/videos/*.webm
